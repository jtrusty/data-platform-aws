# Terraform working directories and state
**/.terraform/*
**/.terraform-ci/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
infra/bootstrap/*/backend.tf

# Local variable and backend files may contain account-specific values
*.tfvars
*.tfvars.json
!infra/environments/sandbox/foundation.auto.tfvars
!infra/environments/development/foundation.auto.tfvars
!infra/environments/production/foundation.auto.tfvars

# Provider downloads are cached once instead of per root
.terraform-plugin-cache/

# Local credentials and environment files
.env
.env.*
!.env.example

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
*.zip
